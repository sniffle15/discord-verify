# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# Public origin users and admins reach (no trailing slash). OAuth redirect URIs
# derived from it must be registered in the Discord developer portal:
#   ${PUBLIC_URL}/api/verify/callback
#   ${PUBLIC_URL}/api/auth/callback
PUBLIC_URL=http://localhost:3000

# API server (Fastify)
HOST=0.0.0.0
PORT=4000
# Used by Next.js rewrites to reach the API in development / without Caddy.
API_INTERNAL_URL=http://localhost:4000

# Number of reverse-proxy hops in front of the API (Caddy = 1, Caddy + Next = 2),
# "true", "false" or a comma separated list of trusted CIDRs.
TRUST_PROXY=1

# ---------------------------------------------------------------------------
# Datastores
# ---------------------------------------------------------------------------
POSTGRES_USER=dv
POSTGRES_PASSWORD=change-me
POSTGRES_DB=discord_verify
DATABASE_URL=postgresql://dv:change-me@localhost:5432/discord_verify?schema=public

REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@localhost:6379

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# 32 random bytes, base64 or hex. Generate with: npm run gen:key
# Losing this key makes every stored token unrecoverable.
ENCRYPTION_KEY=
# Old keys kept for decryption during rotation (comma separated).
ENCRYPTION_KEYS_PREVIOUS=
# Cookie signing secret, at least 32 characters.
SESSION_SECRET=
SESSION_TTL_HOURS=8

# Discord user IDs allowed to sign in to the dashboard (comma separated).
# Deliberately not editable from the dashboard.
ADMIN_DISCORD_IDS=

# ---------------------------------------------------------------------------
# Discord bootstrap values. Anything saved in the dashboard Settings tab
# overrides these.
# ---------------------------------------------------------------------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_VERIFIED_ROLE_ID=
DISCORD_LOG_CHANNEL_ID=

# ---------------------------------------------------------------------------
# Abuse protection
# ---------------------------------------------------------------------------
VERIFY_RATE_LIMIT_MAX=5
VERIFY_RATE_LIMIT_WINDOW_MS=900000

# VPN / proxy detection: none | proxycheck
IP_INTEL_PROVIDER=none
PROXYCHECK_API_KEY=
# Allow verification when the IP intelligence provider is unreachable.
IP_INTEL_FAIL_OPEN=true

# ---------------------------------------------------------------------------
# Workers
# ---------------------------------------------------------------------------
TOKEN_CHECK_CONCURRENCY=4
TOKEN_CHECK_MAX_PER_SECOND=5
RESTORE_CONCURRENCY=2
# At most RESTORE_RATE_MAX guild joins per RESTORE_RATE_DURATION_MS across all workers.
RESTORE_RATE_MAX=10
RESTORE_RATE_DURATION_MS=10000
